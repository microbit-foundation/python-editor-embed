{
  "name": "@microbit/python-editor-embed",
  "version": "0.0.0",
  "description": "",
  "keywords": [],
  "type": "module",
  "sideEffects": false,
  "author": "Micro:bit Educational Foundation <package-help@microbit.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microbit-foundation/python-editor-embed"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "allowScripts": {
    "fsevents": true,
    "esbuild": true
  },
  "packageManager": "npm@11.18.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "typings": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/esm/vanilla/index.d.ts",
        "default": "./dist/esm/vanilla/index.js"
      },
      "require": {
        "types": "./dist/cjs/vanilla/index.d.ts",
        "default": "./dist/cjs/vanilla/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react/index.d.ts",
        "default": "./dist/esm/react/index.js"
      },
      "require": {
        "types": "./dist/cjs/react/index.d.ts",
        "default": "./dist/cjs/react/index.js"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build:esm": "tsc -p tsconfig.build.json && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "build": "npm run build:esm && npm run build:cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run build:storybook",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@microbit/eslint-config": "^0.1.2",
    "@storybook/react-vite": "^10.5.10",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "base64-js": "^1.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.5.10",
    "prettier": "^3.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.10",
    "typedoc": "^0.27.6",
    "typescript": "^5.2.2"
  }
}
